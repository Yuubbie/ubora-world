# Copy this file to .env and fill in real values.

# PostgreSQL connection string. Free options to get one fast: Railway, Render, Neon, Supabase.
DATABASE_URL="postgresql://user:password@localhost:5432/ubora_world"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Optional. Paste the Google Search Console HTML-tag content token (not the full meta tag).
# GOOGLE_SITE_VERIFICATION=""

# Paystack (live keys in Vercel Production). Webhook: https://uboraworld.com.ng/api/payments/webhook
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=

# Resend — signup welcome and password reset mail, From: Ubora World.
# RESEND_API_KEY=
# RESEND_FROM="Ubora World <hello@uboraworld.com.ng>"

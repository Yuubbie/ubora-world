generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(cuid())
  fullName          String
  email             String?            @unique
  phone             String?            @unique
  passwordHash      String
  role              Role               @default(student)
  matricNumber      String?            @unique
  createdAt         DateTime           @default(now())
  assignedRequests  AdmissionRequest[] @relation("assignee")
  admissionRequests AdmissionRequest[] @relation("requester")
  agent             Agent?
  attempts          Attempt[]
  subscriptions     Subscription[]

  @@index([email])
  @@index([matricNumber])
}

model Faculty {
  id          String       @id @default(cuid())
  name        String       @unique
  departments Department[]
}

model Department {
  id        String   @id @default(cuid())
  facultyId String
  name      String
  courses   Course[]
  faculty   Faculty  @relation(fields: [facultyId], references: [id])

  @@index([facultyId])
}

model Course {
  id               String            @id @default(cuid())
  departmentId     String
  code             String            @unique
  title            String
  attempts         Attempt[]
  department       Department        @relation(fields: [departmentId], references: [id])
  pastQuestionSets PastQuestionSet[]
  questionBanks    QuestionBank[]
  summaries        Summary[]
  tutorials        TutorialContent[]

  @@index([departmentId])
}

model Payment {
  id           String        @id @default(cuid())
  userId       String
  amount       Int
  provider     String
  status       PaymentStatus
  reference    String        @unique
  createdAt    DateTime      @default(now())
  subscription Subscription?
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  tier      SubscriptionTier
  startDate DateTime
  endDate   DateTime
  status    SubscriptionStatus @default(active)
  paymentId String?            @unique
  payment   Payment?           @relation(fields: [paymentId], references: [id])
  user      User               @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

model QuestionBank {
  id         String        @id @default(cuid())
  courseId   String
  status     ContentStatus @default(draft)
  createdBy  String
  approvedBy String?
  approvedAt DateTime?
  questions  Question[]
  course     Course        @relation(fields: [courseId], references: [id])

  @@index([courseId, status])
}

model Question {
  id                 String       @id @default(cuid())
  questionBankId     String
  text               String
  options            String[]
  correctOptionIndex Int
  explanation        String?
  questionBank       QuestionBank @relation(fields: [questionBankId], references: [id])

  @@index([questionBankId])
}

model Attempt {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  score       Int
  total       Int
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  course      Course    @relation(fields: [courseId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@index([userId, courseId])
}

model PastQuestionSet {
  id         String        @id @default(cuid())
  courseId   String
  year       Int
  status     ContentStatus @default(draft)
  approvedBy String?
  fileUrl    String?
  approvedAt DateTime?
  course     Course        @relation(fields: [courseId], references: [id])

  @@index([courseId, status])
}

model Summary {
  id         String        @id @default(cuid())
  courseId   String
  title      String
  topicCount Int
  pageCount  Int
  fileUrl    String
  status     ContentStatus @default(draft)
  approvedAt DateTime?
  approvedBy String?
  course     Course        @relation(fields: [courseId], references: [id])

  @@index([courseId, status])
}

model TutorialContent {
  id            String           @id @default(cuid())
  courseId      String
  title         String
  type          TutorialType
  lengthSeconds Int
  tier          SubscriptionTier
  storageUrl    String
  status        ContentStatus    @default(draft)
  approvedAt    DateTime?
  approvedBy    String?
  course        Course           @relation(fields: [courseId], references: [id])

  @@index([courseId, status])
}

model Agent {
  id             String       @id @default(cuid())
  userId         String       @unique
  referralCode   String       @unique
  commissionRate Float        @default(0.15)
  user           User         @relation(fields: [userId], references: [id])
  commissions    Commission[]
  payouts        Payout[]
  referrals      Referral[]
}

model Referral {
  id             String      @id @default(cuid())
  agentId        String
  referredUserId String
  createdAt      DateTime    @default(now())
  commission     Commission?
  agent          Agent       @relation(fields: [agentId], references: [id])

  @@index([agentId])
}

model Commission {
  id           String           @id @default(cuid())
  agentId      String
  referralId   String           @unique
  amount       Int
  status       CommissionStatus @default(pending)
  createdAt    DateTime         @default(now())
  payableAfter DateTime
  agent        Agent            @relation(fields: [agentId], references: [id])
  referral     Referral         @relation(fields: [referralId], references: [id])

  @@index([agentId, status])
}

model Payout {
  id          String       @id @default(cuid())
  agentId     String
  amount      Int
  status      PayoutStatus @default(requested)
  requestedAt DateTime     @default(now())
  paidAt      DateTime?
  agent       Agent        @relation(fields: [agentId], references: [id])

  @@index([agentId])
}

model AdmissionRequest {
  id          String        @id @default(cuid())
  userId      String
  type        String
  description String
  status      RequestStatus @default(submitted)
  assignedTo  String?
  assignee    User?         @relation("assignee", fields: [assignedTo], references: [id])
  user        User          @relation("requester", fields: [userId], references: [id])

  @@index([userId])
}

model ResultCheckerToken {
  id             String  @id @default(cuid())
  code           String  @unique
  used           Boolean @default(false)
  linkedResultId String?
}

model WaitlistSignup {
  id         String   @id @default(cuid())
  fullName   String
  email      String   @unique
  phone      String
  interest   String
  referredBy String?
  createdAt  DateTime @default(now())
}

enum Role {
  student
  agent
  content_partner
  admin
  super_admin
}

enum SubscriptionTier {
  basic
  standard
  premium
}

enum SubscriptionStatus {
  active
  expired
  cancelled
}

enum PaymentStatus {
  success
  failed
  refunded
  pending
}

enum ContentStatus {
  draft
  approved
}

enum TutorialType {
  video
  audio
}

enum CommissionStatus {
  pending
  payable
  paid
  voided
}

enum PayoutStatus {
  requested
  processing
  paid
}

enum RequestStatus {
  submitted
  in_progress
  resolved
}

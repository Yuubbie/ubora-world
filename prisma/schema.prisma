// Ubora World — Prisma schema
// Mirrors Master Spec Section 5 (Data Model) exactly.
// Phase 1 uses: User, Faculty, Department, Course, Subscription (schema only, no live
// payment yet), QuestionBank, Question, Attempt, PastQuestionSet, Summary.
// Later-phase models (Agent, Referral, Commission, Payout, AdmissionRequest,
// TutorialContent, ResultCheckerToken) are defined now so the schema doesn't need
// breaking migrations when those phases start — but are not wired into app logic yet.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  agent
  content_partner
  admin
  super_admin
}

enum SubscriptionTier {
  basic
  standard
  premium
}

enum SubscriptionStatus {
  active
  expired
  cancelled
}

enum PaymentStatus {
  pending
  success
  failed
  refunded
}

enum ContentStatus {
  draft
  approved
}

enum TutorialType {
  video
  audio
}

enum CommissionStatus {
  pending
  payable
  paid
  voided
}

enum PayoutStatus {
  requested
  processing
  paid
}

enum RequestStatus {
  submitted
  in_progress
  resolved
}

model User {
  id            String    @id @default(cuid())
  fullName      String
  email         String?   @unique
  phone         String?   @unique
  passwordHash  String
  role          Role      @default(student)
  matricNumber  String?   @unique
  createdAt     DateTime  @default(now())

  subscriptions Subscription[]
  attempts      Attempt[]
  agent         Agent?
  admissionRequests AdmissionRequest[] @relation("requester")
  assignedRequests  AdmissionRequest[] @relation("assignee")

  @@index([email])
  @@index([matricNumber])
}

model Faculty {
  id          String       @id @default(cuid())
  name        String       @unique
  departments Department[]
}

model Department {
  id        String   @id @default(cuid())
  facultyId String
  faculty   Faculty  @relation(fields: [facultyId], references: [id])
  name      String
  courses   Course[]

  @@index([facultyId])
}

model Course {
  id           String   @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  code         String   @unique
  title        String

  questionBanks    QuestionBank[]
  attempts         Attempt[]
  pastQuestionSets PastQuestionSet[]
  summaries        Summary[]
  tutorials        TutorialContent[]

  @@index([departmentId])
}

model Payment {
  id            String        @id @default(cuid())
  userId        String
  amount        Int           // store in kobo (smallest unit) to avoid float errors
  provider      String        // "paystack" | "flutterwave"
  status        PaymentStatus
  reference     String        @unique
  createdAt     DateTime      @default(now())

  subscription  Subscription?
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id])
  tier      SubscriptionTier
  startDate DateTime
  endDate   DateTime
  status    SubscriptionStatus @default(active)
  paymentId String?            @unique
  payment   Payment?           @relation(fields: [paymentId], references: [id])

  @@index([userId])
  @@index([status])
}

model QuestionBank {
  id         String         @id @default(cuid())
  courseId   String
  course     Course         @relation(fields: [courseId], references: [id])
  status     ContentStatus  @default(draft)
  createdBy  String
  approvedBy String?
  approvedAt DateTime?
  questions  Question[]

  @@index([courseId, status])
}

model Question {
  id                String       @id @default(cuid())
  questionBankId    String
  questionBank      QuestionBank @relation(fields: [questionBankId], references: [id])
  text              String
  options           String[]
  correctOptionIndex Int

  @@index([questionBankId])
}

model Attempt {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id])
  score       Int
  total       Int
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([userId, courseId])
}

model PastQuestionSet {
  id         String        @id @default(cuid())
  courseId   String
  course     Course        @relation(fields: [courseId], references: [id])
  year       Int
  status     ContentStatus @default(draft)
  approvedBy String?
  approvedAt DateTime?
  fileUrl    String?

  @@index([courseId, status])
}

model Summary {
  id         String        @id @default(cuid())
  courseId   String
  course     Course        @relation(fields: [courseId], references: [id])
  title      String
  topicCount Int
  pageCount  Int
  fileUrl    String
  status     ContentStatus @default(draft)
  approvedBy String?
  approvedAt DateTime?

  @@index([courseId, status])
}

model TutorialContent {
  id             String        @id @default(cuid())
  courseId       String
  course         Course        @relation(fields: [courseId], references: [id])
  title          String
  type           TutorialType
  lengthSeconds  Int
  tier           SubscriptionTier
  storageUrl     String
  status         ContentStatus @default(draft)
  approvedBy     String?
  approvedAt     DateTime?

  @@index([courseId, status])
}

model Agent {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  referralCode   String   @unique
  commissionRate Float    @default(0.15)

  referrals   Referral[]
  commissions Commission[]
  payouts     Payout[]
}

model Referral {
  id             String   @id @default(cuid())
  agentId        String
  agent          Agent    @relation(fields: [agentId], references: [id])
  referredUserId String
  createdAt      DateTime @default(now())

  commission Commission?

  @@index([agentId])
}

model Commission {
  id          String            @id @default(cuid())
  agentId     String
  agent       Agent             @relation(fields: [agentId], references: [id])
  referralId  String            @unique
  referral    Referral          @relation(fields: [referralId], references: [id])
  amount      Int
  status      CommissionStatus  @default(pending)
  createdAt   DateTime          @default(now())
  payableAfter DateTime

  @@index([agentId, status])
}

model Payout {
  id          String       @id @default(cuid())
  agentId     String
  agent       Agent        @relation(fields: [agentId], references: [id])
  amount      Int
  status      PayoutStatus @default(requested)
  requestedAt DateTime     @default(now())
  paidAt      DateTime?

  @@index([agentId])
}

model AdmissionRequest {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation("requester", fields: [userId], references: [id])
  type        String
  description String
  status      RequestStatus @default(submitted)
  assignedTo  String?
  assignee    User?         @relation("assignee", fields: [assignedTo], references: [id])

  @@index([userId])
}

// Deferred until Open Decision #1 (Master Spec Section 11) is resolved.
model ResultCheckerToken {
  id            String  @id @default(cuid())
  code          String  @unique
  used          Boolean @default(false)
  linkedResultId String?
} model WaitlistSignup {
  id         String   @id @default(cuid())
  fullName   String
  email      String   @unique
  phone      String
  interest   String
  referredBy String?
  createdAt  DateTime @default(now())
}
